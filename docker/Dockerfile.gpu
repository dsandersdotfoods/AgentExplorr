# =============================================================================
# AgentExplorr — GPU Docker Image (CUDA)
# =============================================================================
# For training and inference on NVIDIA GPUs.
#
# Usage:
#   docker build -f docker/Dockerfile.gpu -t agentexplorr:gpu .
#   docker run --gpus all -it agentexplorr:gpu python -c "import torch; print(torch.cuda.is_available())"
#
# LEARNING RESOURCE:
#   - NVIDIA Container Toolkit: https://docs.nvidia.com/datacenter/cloud-native/container-toolkit/
#   - VIDEO: "Docker + GPU" — https://www.youtube.com/watch?v=OBNf7JLMVWU
# =============================================================================

FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04

# Install Python 3.12 and system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 python3.12-venv python3.12-dev python3-pip \
    git curl build-essential && \
    rm -rf /var/lib/apt/lists/*

# Make python3.12 the default
RUN update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy and install dependencies
COPY pyproject.toml uv.lock* ./
RUN uv sync --all-extras --no-dev --no-install-project

# Copy source
COPY src/ ./src/
COPY configs/ ./configs/
COPY notebooks/ ./notebooks/

RUN uv sync --all-extras --no-dev

ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src:$PYTHONPATH"

# Verify CUDA is accessible
RUN python -c "import torch; print(f'CUDA available: {torch.cuda.is_available()}')" || true

CMD ["python", "-m", "agentexplorr"]
