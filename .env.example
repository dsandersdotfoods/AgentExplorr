# =============================================================================
# AgentExplorr — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# ---------------------------------------------------------------------------
# Ollama — Local LLM inference server (open source, no API key needed!)
# ---------------------------------------------------------------------------
# Install Ollama: https://ollama.ai/download
# Then pull a model: ollama pull llama3.2
# VIDEO: "Ollama Explained" — https://www.youtube.com/watch?v=jl2yUEdG-vo
OLLAMA_BASE_URL=http://localhost:11434

# Default model for agent and RAG tasks (smaller = faster for dev)
# Options: llama3.2, mistral, phi3, gemma2, qwen2.5
OLLAMA_MODEL=llama3.2

# Embedding model for RAG (runs locally via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# Hugging Face — Model hub for downloading models & datasets
# ---------------------------------------------------------------------------
# Create a free token at: https://huggingface.co/settings/tokens
# Needed for: gated models (Llama), private datasets, pushing to Hub
HF_TOKEN=

# ---------------------------------------------------------------------------
# MLflow — Experiment tracking (self-hosted, open source)
# ---------------------------------------------------------------------------
# VIDEO: "MLflow Tutorial" — https://www.youtube.com/watch?v=ksYIVDue8ak
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=agentexplorr

# ---------------------------------------------------------------------------
# Application settings
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
ENVIRONMENT=development
